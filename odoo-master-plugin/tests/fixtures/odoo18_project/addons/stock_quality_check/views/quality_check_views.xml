<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_quality_check_view_list" model="ir.ui.view">
        <field name="name">stock.quality.check.list</field>
        <field name="model">stock.quality.check</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="picking_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="stock_quality_check_view_form" model="ir.ui.view">
        <field name="name">stock.quality.check.form</field>
        <field name="model">stock.quality.check</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_pass" type="object" string="Pass" invisible="state != 'todo'"/>
                    <button name="action_fail" type="object" string="Fail" invisible="state != 'todo'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="picking_id"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="stock_quality_check_action" model="ir.actions.act_window">
        <field name="name">Quality Checks</field>
        <field name="res_model">stock.quality.check</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="stock_quality_check_menu" name="Quality Checks" parent="stock.menu_stock_warehouse_mgmt"
              action="stock_quality_check_action" sequence="50"/>
</odoo>
