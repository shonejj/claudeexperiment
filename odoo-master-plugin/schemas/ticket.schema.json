{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "odoo-master/ticket.schema.json",
  "title": "Normalized ticket (Jira, Linear, GitHub issue, Slack report)",
  "type": "object",
  "required": [
    "provider",
    "key",
    "title"
  ],
  "properties": {
    "provider": {
      "type": "string",
      "examples": [
        "jira",
        "linear",
        "github",
        "slack"
      ]
    },
    "key": {
      "type": "string",
      "description": "provider-native id, e.g. PROJ-123, owner/repo#45, Slack channel/ts"
    },
    "url": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assignee": {
      "type": [
        "string",
        "null"
      ]
    },
    "reporter": {
      "type": [
        "string",
        "null"
      ]
    },
    "priority": {
      "type": [
        "string",
        "null"
      ]
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "author": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "created": {
            "type": "string"
          }
        }
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "links": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "pull_request": {
          "type": "string"
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "execution_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "visibility": {
      "enum": [
        "public",
        "internal",
        "private"
      ],
      "default": "internal"
    }
  }
}