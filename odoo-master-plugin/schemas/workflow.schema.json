{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "odoo-master/workflow.schema.json",
  "title": "Odoo Master workflow definition",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "version",
    "description",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string"
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "classification": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "request intents this workflow serves"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "default": {}
        },
        "additionalProperties": false
      }
    },
    "defaults": {
      "type": "object",
      "properties": {
        "timeout_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "retries": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "type": {
          "enum": [
            "task",
            "approval",
            "notify"
          ],
          "default": "task"
        },
        "title": {
          "type": "string"
        },
        "agent": {
          "type": "string"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capability": {
          "type": "string",
          "description": "MCP capability for notify/ticket steps, e.g. ticket.add_comment"
        },
        "needs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "when": {
          "type": [
            "string",
            "boolean"
          ]
        },
        "instructions": {
          "type": "string"
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "timeout_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "parallel_group": {
          "type": "string"
        },
        "on_failure": {
          "oneOf": [
            {
              "enum": [
                "fail",
                "continue"
              ]
            },
            {
              "type": "object",
              "required": [
                "retry_from"
              ],
              "additionalProperties": false,
              "properties": {
                "retry_from": {
                  "type": "string"
                },
                "max_loops": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                }
              }
            }
          ]
        },
        "approvers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "auto_approve_when": {
          "type": [
            "string",
            "boolean"
          ]
        },
        "always_human": {
          "type": "boolean"
        },
        "on_reject": {
          "type": "string"
        },
        "present": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}